build: go build -trimpath \ ; -ldflags "-X main.version=${VERSION}" \ ; -o "${{ matrix.binary }}" \ ; ./cmd/rescrobble ; if ! ./"${{ matrix.binary }}" --help >/dev/null; then ; echo "error: ${{ matrix.binary }} --help failed" >&2 ; exit 1 ; fi ; actual_version="$(./"${{ matrix.binary }}" --version)" ; if [[ "${actual_version}" != "${VERSION}" ]]; then ; echo "error: expected version ${VERSION}, got ${actual_version}" >&2 ; exit 1 ; fi
release: binaries=( ; rescrobble-windows-amd64.exe ; rescrobble-darwin-amd64 ; rescrobble-darwin-arm64 ; rescrobble-linux-amd64 ; ) ; for binary in "${binaries[@]}"; do ; if [[ ! -f "${binary}" ]]; then ; echo "error: missing release binary ${binary}" >&2 ; exit 1 ; fi ; done ; if [[ "$(find . -maxdepth 1 -type f | wc -l)" -ne "${#binaries[@]}" ]]; then ; echo "error: release artifact directory contains unexpected files" >&2 ; exit 1 ; fi ; sha256sum "${binaries[@]}" > SHA256SUMS ; if [[ "$(wc -l < SHA256SUMS)" -ne 4 ]]; then ; echo "error: SHA256SUMS does not contain exactly four entries" >&2 ; exit 1 ; fi
